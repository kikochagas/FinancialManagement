# Database Configuration
# Local SQLite
DATABASE_URL="file:../dev.db"

# Turso (Production)
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your_turso_auth_token"

# Authentication
# Required in production. Generate a secure random string (e.g. `openssl rand -base64 32`)
JWT_SECRET="your_secure_jwt_secret"

# Application URL
APP_URL=http://localhost:3000

# Enable Banking (Open Banking Integration)
ENABLE_BANKING_APPLICATION_ID="your_application_id"
# Provide EITHER the literal key (newlines can be escaped as \n) OR the path to the PEM file
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ENABLE_BANKING_PRIVATE_KEY_PATH="./secrets/enable-banking.pem"

# OpenAI (Used for Bank Statement Import unstructured mapping)
# AI will gracefully degrade to manual mapping if absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
